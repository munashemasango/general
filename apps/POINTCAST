}
function drawSpark(seg){const cv=$('#spark'),dpr=devicePixelRatio||1,W=cv.clientWidth,H=74;
  cv.width=W*dpr;cv.height=H*dpr;const x=cv.getContext('2d');x.scale(dpr,dpr);x.clearRect(0,0,W,H);
  const n=seg.t.length;if(n<2)return;
