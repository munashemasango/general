  for(let i=1;i<n;i++){const xm=(X(i-1)+X(i))/2;x.quadraticCurveTo(X(i-1),Y(seg.t[i-1]),xm,(Y(seg.t[i-1])+Y(seg.t[i]))/2);}
  x.quadraticCurveTo(X(n-1),Y(seg.t[n-1]),X(n-1),Y(seg.t[n-1]));
  const g=x.createLinearGradient(0,0,0,H);g.addColorStop(0,'rgba(255,181,36,.35)');g.addColorStop(1,'rgba(255,181,36,0)');
  x.save();x.lineTo(X(n-1),H);x.lineTo(X(0),H);x.closePath();x.fillStyle=g;x.fill();x.restore();
  x.beginPath();x.moveTo(X(0),Y(seg.t[0]));
  for(let i=1;i<n;i++){const xm=(X(i-1)+X(i))/2;x.quadraticCurveTo(X(i-1),Y(seg.t[i-1]),xm,(Y(seg.t[i-1])+Y(seg.t[i]))/2);}
  x.quadraticCurveTo(X(n-1),Y(seg.t[n-1]),X(n-1),Y(seg.t[n-1]));
  x.strokeStyle='#ffb524';x.lineWidth=2.4;x.lineJoin='round';x.stroke();
}
function renderDaily(){const d=DATA.daily,wf=new Intl.DateTimeFormat(undefined,{weekday:'short',timeZone:TZ});
  const wmin=Math.min(...d.temperature_2m_min.slice(0,7)),wmax=Math.max(...d.temperature_2m_max.slice(0,7)),range=(wmax-wmin)||1;
  const box=$('#daily');box.innerHTML='';
  for(let i=0;i<7;i++){const dt=new Date(d.time[i]+'T12:00');
    const l=i===0?'TODAY':wf.format(dt).toUpperCase();
    const left=((d.temperature_2m_min[i]-wmin)/range)*100,width=Math.max(6,((d.temperature_2m_max[i]-d.temperature_2m_min[i])/range)*100);
    const row=document.createElement('div');row.className='drow';
    row.innerHTML=`<span class="dn">${l}</span>${icon(wmeta(d.weather_code[i])[1],26)}<span class="dp">${d.precipitation_probability_max[i]??0}%</span><div class="dbar"><i style="left:${left}%;width:${width}%"></i></div><span class="dt"><b>${ft(d.temperature_2m_max[i])}</b> / ${ft(d.temperature_2m_min[i])}</span>`;
    row.title=wmeta(d.weather_code[i])[0]+(d.precipitation_sum[i]?` · ${fmm(d.precipitation_sum[i])} precip`:'');
    box.appendChild(row);}
}
function renderArc(){const d=DATA.daily,now=new Date(DATA.current.time);
  const sr=new Date(d.sunrise[0]),ss=new Date(d.sunset[0]);
  const path=$('#sunpath'),mk=$('#sunmk'),halo=$('#mkhalo');
  $('#srise').textContent=fmtHM(d.sunrise[0]);$('#sset').textContent=fmtHM(d.sunset[0]);
  let f,night=false;
  if(now>=sr&&now<=ss){f=(now-sr)/(ss-sr||1);$('#arclbl').textContent='DAYLIGHT';}
  else{night=true;const sr2=d.sunrise[1]?new Date(d.sunrise[1]):new Date(sr.getTime()+864e5);
    const from=now>ss?ss:sr2, to=now>ss?sr2:ss;f=(now-from)/((to-from)||1);$('#arclbl').textContent='NIGHT';}
  f=clampN(f,0,1);
  try{const len=path.getTotalLength(),p=path.getPointAtLength(len*f);
    mk.setAttribute('cx',p.x);mk.setAttribute('cy',p.y);halo.setAttribute('cx',p.x);halo.setAttribute('cy',p.y);
    mk.setAttribute('fill',night?'#dfe6f5':'#ffb524');halo.setAttribute('stroke',night?'#dfe6f5':'#ffb524');
    mk.classList.toggle('night',night);mk.style.display='';halo.style.display='';
    $('#arcnote').textContent=night?'☾':Math.round(f*100)+'%';
  }catch(e){mk.style.display='none';halo.style.display='none';}
}
function startClock(){clearInterval(TIMER);TIMER=setInterval(()=>{$('#asof').innerHTML=`MODEL RUN ${String(DATA.current.time).slice(11,16)}<br>LOCAL ${fmtClock()}`;},1000);}
function renderAll(){renderHero();renderPlace();renderMetrics();renderHourly();renderDaily();renderArc();startClock();}

/* ================= fetch + track ================= */
function validCoords(la,lo){return isFinite(la)&&isFinite(lo)&&Math.abs(la)<=90&&Math.abs(lo)<=180;}
async function track(la,lo,opts={}){
  la=+la;lo=+lo;
  if(!validCoords(la,lo)){toast('Coordinates out of range — lat ±90, lon ±180.');return;}
  $('#lat').value=(+la.toFixed(4));$('#lon').value=(+lo.toFixed(4));
  history.replaceState(null,'',`#${la.toFixed(4)},${lo.toFixed(4)}`);
  led('busy','SYNC');
  $$('#pname,#psub,#tval').forEach(e=>e.classList.add('skel'));
  try{
    const[wx,pl]=await Promise.all([fetchJSON(wxURL(la,lo)),fetchJSON(placeURL(la,lo)).catch(()=>null)]);
    DATA=wx;TZ=wx.timezone||'UTC';
    const idx=wx.hourly.time.findIndex(t=>t>=wx.current.time);
    HOURS=wx.hourly;HOURS.i=Math.max(0,idx===-1?0:idx);
    const nm=pl?.locality||pl?.city||pl?.principalSubdivision||pl?.countryName;
    PLACE={name:nm,sub:pl?.principalSubdivision,country:pl?.countryName,
      grid:pl?.localityInfo?.informative?.find(r=>r.order===8)?.description};
    setTheme(themeFor(wx.current.weather_code,wx.current.is_day===1));
    renderAll();led('ok','LIVE');
    if(opts.announce)toast(opts.announce);
  }catch(e){console.error(e);led('err','NO SIGNAL');toast('Couldn’t reach the weather service — check your connection.');}
}

/* ================= controls ================= */
$('#go').addEventListener('click',()=>track($('#lat').value,$('#lon').value));
[$('#lat'),$('#lon')].forEach(inp=>inp.addEventListener('keydown',e=>{if(e.key==='Enter')track($('#lat').value,$('#lon').value);}));

/* steppers with hold-to-repeat */
$$('.stepped button').forEach(b=>{
  const step=()=>{const inp=$('#'+b.dataset.t),d=+b.dataset.d*0.01;
    let v=parseFloat(inp.value)||0;v=+(v+d).toFixed(4);
    if(b.dataset.t==='lat')v=clampN(v,-90,90);else v=clampN(v,-180,180);inp.value=v;};
  let t1,t2;b.addEventListener('pointerdown',e=>{e.preventDefault();step();
    t1=setTimeout(()=>{t2=setInterval(step,70);},420);
    const end=()=>{clearTimeout(t1);clearInterval(t2);b.removeEventListener('pointerup',end);b.removeEventListener('pointerleave',end);};
    b.addEventListener('pointerup',end);b.addEventListener('pointerleave',end);});
  b.addEventListener('click',e=>e.preventDefault());
});

$('#geo').addEventListener('click',()=>{
  if(!navigator.geolocation){toast('Geolocation not supported by this browser.');return;}
  led('busy','FIXING');
  navigator.geolocation.getCurrentPosition(
    p=>track(p.coords.latitude,p.coords.longitude,{announce:'Target locked: your position.'}),
    ()=>{led('ok','LIVE');toast('Location permission denied — enter coordinates instead.');},
    {timeout:8000,maximumAge:300000});
});

/* search */
let qTimer=null;
const qEl=$('#q'),qres=$('#qres');
qEl.addEventListener('input',()=>{clearTimeout(qTimer);const v=qEl.value.trim();
  if(!v){qres.classList.remove('open');return;}
  qTimer=setTimeout(async()=>{
    const m=v.match(/^(-?\d{1,2}(?:\.\d+)?)\s*[,;\s]\s*(-?\d{1,3}(?:\.\d+)?)$/);
    if(m){const la=+m[1],lo=+m[2];
      qres.innerHTML=`<button data-la="${la}" data-lo="${lo}"><span>◎ Go to exact coordinates</span><span class="crd">${la.toFixed(4)}, ${lo.toFixed(4)}</span></button>`;
      qres.classList.add('open');return;}
    try{const g=await fetchJSON(geoURL(v));
      if(!g.results?.length){qres.innerHTML='<button disabled style="opacity:.55">No match found</button>';qres.classList.add('open');return;}
      qres.innerHTML=g.results.map(r=>`<button data-la="${r.latitude}" data-lo="${r.longitude}"><span><b>${esc(r.name)}</b>${r.admin1?' · '+esc(r.admin1):''}${r.country_name?' · '+esc(r.country_name):''}</span><span class="crd">${r.latitude.toFixed(2)}, ${r.longitude.toFixed(2)}</span></button>`).join('');
      qres.classList.add('open');
    }catch(e){qres.classList.remove('open');}
  },320);});
qres.addEventListener('pointerdown',e=>{const b=e.target.closest('button[data-la]');if(!b)return;e.preventDefault();
  qEl.value=b.querySelector('b')?.textContent||qEl.value;qres.classList.remove('open');track(b.dataset.la,b.dataset.lo);});
qEl.addEventListener('keydown',e=>{if(e.key==='Enter'){const b=qres.querySelector('button[data-la]');if(b){qres.classList.remove('open');track(b.dataset.la,b.dataset.lo);}}
  if(e.key==='Escape')qres.classList.remove('open');});
document.addEventListener('click',e=>{if(!e.target.closest('.searchwrap'))qres.classList.remove('open');});

/* units */
function setUnit(u){U=u;localStorage.setItem('pc-unit',u);
  $('#uC').classList.toggle('on',u==='c');$('#uF').classList.toggle('on',u==='f');
  if(DATA){PREVT=null;renderHero();renderMetrics();renderHourly();renderDaily();}}
$('#uC').addEventListener('click',()=>setUnit('c'));$('#uF').addEventListener('click',()=>setUnit('f'));

/* copy buttons */
$('#copycrd').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(`${DATA.latitude.toFixed(4)}, ${DATA.longitude.toFixed(4)}`);toast('Coordinates copied.');}catch(e){toast('Copy blocked by browser.');}});
$('#copylink').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);toast('Shareable link copied.');}catch(e){toast('Copy blocked by browser.');}});

/* hourly drag-scroll + tooltip */
const chips=$('#chips');let dragging=false,dx=0,sl=0,moved=false;
chips.addEventListener('pointerdown',e=>{if(e.pointerType!=='mouse')return;dragging=true;moved=false;dx=e.clientX;sl=chips.scrollLeft;});
window.addEventListener('pointermove',e=>{if(!dragging)return;if(Math.abs(e.clientX-dx)>4)moved=true;chips.scrollLeft=sl-(e.clientX-dx);});
window.addEventListener('pointerup',()=>dragging=false);
chips.addEventListener('click',e=>{if(moved){e.preventDefault();e.stopPropagation();}},true);
const tip=$('#tip');
chips.addEventListener('pointermove',e=>{const c=e.target.closest('.hchip');if(!c||dragging){tip.classList.remove('on');return;}
  const i=+c.dataset.i,r=$('.hrwrap').getBoundingClientRect(),cr=c.getBoundingClientRect();
  tip.textContent=`${HOURS.l? '':''}${c.querySelector('.hh').textContent} · ${c.querySelector('.ht').textContent} · ${c.querySelector('.hp').textContent.trim()==='&nbsp;'||!c.querySelector('.hp').textContent.trim()?'0%':c.querySelector('.hp').textContent} rain`;
  tip.style.left=(cr.left-r.left+cr.width/2)+'px';tip.style.top=(cr.top-r.top)+'px';tip.classList.add('on');});
chips.addEventListener('pointerleave',()=>tip.classList.remove('on'));

/* utc ticker + resize */
setInterval(()=>{$('#utc').textContent=new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'UTC',hour12:false}).format(new Date())+' UTC';},1000);
let rz;window.addEventListener('resize',()=>{clearTimeout(rz);rz=setTimeout(()=>{if(HOURS)renderHourly();},180);});

/* reveals */
const io=new IntersectionObserver(es=>es.forEach(en=>{if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}}),{threshold:.08});
$$('.reveal').forEach(el=>io.observe(el));

/* ================= boot ================= */
setTheme('clear-d');
(function boot(){
  const m=location.hash.match(/^#(-?\d+(?:\.\d+)?)[,;](-?\d+(?:\.\d+)?)$/);
  if(m){track(+m[1],+m[2]);return;}
  if(navigator.geolocation){
    const done=new Promise(res=>navigator.geolocation.getCurrentPosition(
      p=>res([p.coords.latitude,p.coords.longitude]),()=>res(null),{timeout:3500,maximumAge:600000}));
    const bail=new Promise(res=>setTimeout(()=>res(null),4200));
    Promise.race([done,bail]).then(c=>{
      if(c)track(c[0],c[1],{announce:'Auto-locked your position — set coordinates or search to retarget.'});
      else track(51.4779,-0.0015,{announce:'No location shared — tracking the Prime Meridian, Greenwich.'});
    });
  } else track(51.4779,-0.0015,{announce:'Tracking the Prime Meridian, Greenwich.'});
})();
})();
</script>
