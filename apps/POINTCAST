    seg.t.push(h.temperature_2m[j]);seg.p.push(h.precipitation_probability?.[j]??0);seg.c.push(h.weather_code[j]);seg.l.push(String(h.time[j]).slice(11,16));
    const d=document.createElement('div');d.className='hchip'+(k===0?' now':'');d.dataset.i=k;
    d.innerHTML=`<div class="hh">${k===0?'NOW':String(h.time[j]).slice(11,16)}</div>${icon(wmeta(h.weather_code[j])[1],20)}<div class="ht">${ft(h.temperature_2m[j])}</div><div class="hp">${(h.precipitation_probability?.[j]??0)>4?(h.precipitation_probability[j]+'%'):'&nbsp;'}</div>`;
    wrap.appendChild(d);}
