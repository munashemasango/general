<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>POINTCAST — hi-res point weather</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ---------- tokens ---------- */
:root{
  --ink:#0f2038; --paper:#f7f4ec; --paper2:#ede8db; --card:#fffdf7;
  --accent:#ff5a1f; --gold:#ffb524; --blue:#2f8fdd;
  --on-sky:#0f2038;
  --shadow:7px 7px 0 rgba(15,32,56,.85);
  --shadow-sm:4px 4px 0 rgba(15,32,56,.85);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'IBM Plex Mono',monospace;
  color:var(--ink);
  background:#79b6e6;
  min-height:100vh;
  overflow-x:hidden;
}
::selection{background:var(--accent);color:#fff}
h1,h2,h3,.disp{font-family:'Bricolage Grotesque','IBM Plex Mono',sans-serif}
button{font-family:inherit;cursor:pointer}
input{font-family:inherit}
a{color:inherit}

/* ---------- sky layers ---------- */
.sky-layer{position:fixed;inset:0;z-index:-2;opacity:0;transition:opacity 1.6s ease;
  background:linear-gradient(180deg,#79b6e6,#d9ecf8)}
.sky-layer.on{opacity:1}
.vignette{position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:radial-gradient(120% 90% at 50% 0%,transparent 55%,rgba(10,20,40,.18))}

/* ---------- header ---------- */
header{
  position:sticky;top:0;z-index:50;
  display:flex;align-items:center;gap:16px;flex-wrap:wrap;
  padding:10px 22px;
  background:rgba(15,32,56,.93);color:var(--paper);
  border-bottom:2px solid rgba(247,244,236,.2);
  backdrop-filter:blur(5px);
}
.brand{display:flex;align-items:center;gap:10px}
.brand svg{flex:none}
.brand b{font-family:'Bricolage Grotesque';font-weight:800;font-size:21px;letter-spacing:.04em}
.brand b i{font-style:normal;color:var(--accent)}
.brand small{display:block;font-size:9px;letter-spacing:.3em;opacity:.65;margin-top:1px}
.hdr-right{margin-left:auto;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.seg{display:flex;border:2px solid var(--paper);border-radius:8px;overflow:hidden}
.seg button{background:transparent;border:0;color:var(--paper);font-weight:700;font-size:12px;padding:5px 10px;transition:background .2s,color .2s}
.seg button.on{background:var(--accent);color:#fff}
.seg button:not(.on):hover{background:rgba(247,244,236,.15)}
#utc{font-size:12px;letter-spacing:.08em;opacity:.85}
.status{display:flex;align-items:center;gap:7px;font-size:10px;letter-spacing:.2em}
.led{width:9px;height:9px;border-radius:50%;background:#3ddc84;box-shadow:0 0 0 0 rgba(61,220,132,.6);animation:pulse 1.8s infinite}
.led.busy{background:var(--gold);animation:pulse .7s infinite}
.led.err{background:#ff4d4d;animation:none}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,255,255,.45)}70%{box-shadow:0 0 0 7px rgba(255,255,255,0)}100%{box-shadow:0 0 0 0 rgba(255,255,255,0)}}

/* ---------- layout ---------- */
main{max-width:1280px;margin:0 auto;padding:22px 20px 60px;
  display:grid;grid-template-columns:355px 1fr;gap:22px;align-items:start}
.col{display:flex;flex-direction:column;gap:22px;min-width:0}
@media(max-width:990px){main{grid-template-columns:1fr}}

/* ---------- panels ---------- */
.panel{background:var(--paper);border:2px solid var(--ink);border-radius:12px;box-shadow:var(--shadow)}
.ph{display:flex;justify-content:space-between;align-items:center;gap:10px;
  padding:10px 16px;border-bottom:2px solid var(--ink);
  font-size:11px;font-weight:600;letter-spacing:.2em}
.ph .idx{color:var(--accent);font-weight:700}
.pbody{padding:16px}
.lbl{font-size:10px;letter-spacing:.22em;font-weight:600;opacity:.6;text-transform:uppercase}

/* reveal */
.reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
.reveal.in{opacity:1;transform:none}

/* ---------- coordinates panel ---------- */
.coords{display:grid;grid-template-columns:1fr;gap:12px}
.field label{display:block;margin-bottom:6px}
.stepped{display:flex;border:2px solid var(--ink);border-radius:9px;overflow:hidden;background:#fff}
.stepped input{flex:1;min-width:0;border:0;outline:none;padding:10px 10px;font-size:15px;font-weight:600;background:transparent}
.stepped input:focus{background:#fff8e9}
.stepped button{width:32px;border:0;background:var(--paper2);font-size:16px;font-weight:700;color:var(--ink);transition:background .15s}
.stepped button:hover{background:var(--gold)}
.stepped button:active{background:var(--accent);color:#fff}
.btnrow{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap}
.btn{font-family:'Bricolage Grotesque';font-weight:800;font-size:13px;letter-spacing:.08em;text-transform:uppercase;
  border:2px solid var(--ink);border-radius:9px;padding:11px 16px;background:var(--accent);color:#fff;
  box-shadow:var(--shadow-sm);transition:transform .15s,box-shadow .15s;display:inline-flex;align-items:center;gap:8px}
.btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 rgba(15,32,56,.85)}
.btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 rgba(15,32,56,.85)}
.btn.ghost{background:var(--paper);color:var(--ink)}
.btn.slim{padding:8px 12px;font-size:11px}
.divider{display:flex;align-items:center;gap:10px;margin:16px 0 12px;font-size:10px;letter-spacing:.3em;opacity:.55}
.divider::before,.divider::after{content:'';flex:1;height:2px;background:rgba(15,32,56,.15)}
.searchwrap{position:relative}
#q{width:100%;border:2px solid var(--ink);border-radius:9px;padding:11px 12px;font-size:14px;background:#fff;outline:none;transition:box-shadow .2s}
#q:focus{box-shadow:0 0 0 3px rgba(255,90,31,.4)}
#qres{position:absolute;left:0;right:0;top:calc(100% + 6px);z-index:30;background:var(--card);
  border:2px solid var(--ink);border-radius:10px;box-shadow:var(--shadow);overflow:hidden;display:none}
#qres.open{display:block}
#qres button{display:flex;justify-content:space-between;gap:10px;width:100%;text-align:left;
  background:none;border:0;border-bottom:1px solid rgba(15,32,56,.12);padding:10px 12px;font-size:13px;transition:background .15s}
#qres button:last-child{border-bottom:0}
#qres button:hover,#qres button.hl{background:var(--gold)}
#qres .crd{font-size:10px;opacity:.6;white-space:nowrap}
.hint{margin-top:10px;font-size:10px;opacity:.55;line-height:1.6}

/* ---------- place panel ---------- */
#pname{font-family:'Bricolage Grotesque';font-weight:800;font-size:clamp(24px,3.4vw,34px);line-height:1.05;letter-spacing:-.01em}
#psub{font-size:12px;opacity:.7;margin-top:5px}
.pmeta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;border-top:2px dashed rgba(15,32,56,.25);padding-top:14px}
.pmeta div b{display:block;font-size:13px;font-weight:600;margin-top:3px}
.copyrow{margin-top:14px;display:flex;align-items:center;gap:10px}
#pcoords{font-size:12px;font-weight:600;letter-spacing:.03em}
.apx{margin-top:12px;font-size:10px;opacity:.5;line-height:1.5}

/* ---------- sky panel ---------- */
.sky{position:relative;overflow:hidden;min-height:430px;border:2px solid var(--ink);border-radius:14px;
  box-shadow:var(--shadow);color:var(--on-sky);
  background:linear-gradient(180deg,#79b6e6,#d9ecf8);transition:background 1s}
.sky::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(130% 100% at 50% -10%,transparent 60%,rgba(5,12,28,.22))}
.fx{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.fx>*{transition:opacity 1.2s ease}
.fx .stars,.fx .clouds,.fx .flakes,.fx .rain,.fx .fogb,.fx .flash,.fx .sun-disc,.fx .moon{opacity:0}
body[data-theme="clear-d"] .sun-disc{opacity:1}
body[data-theme="part-d"] .sun-disc{opacity:.55}
body[data-theme="clear-n"] .stars,body[data-theme="part-n"] .stars{opacity:1}
body[data-theme="clear-n"] .moon{opacity:1}
body[data-theme="part-d"] .clouds{opacity:.55}
body[data-theme="part-n"] .clouds{opacity:.5}
body[data-theme="over-d"] .clouds,body[data-theme="over-n"] .clouds{opacity:1}
body[data-theme="rain"] .clouds,body[data-theme="thunder"] .clouds{opacity:.95}
body[data-theme="rain"] .rain,body[data-theme="thunder"] .rain{opacity:.85}
body[data-theme="thunder"] .flash{opacity:1}
body[data-theme="snow"] .flakes{opacity:1}
body[data-theme="snow"] .clouds{opacity:.6}
body[data-theme="fog"] .fogb{opacity:1}
body[data-theme="fog"] .clouds{opacity:.4}
body[data-theme="over-n"] .stars,body[data-theme="thunder"] .stars{opacity:.35}

.stars span{position:absolute;background:#fff;border-radius:50%;animation:twinkle 3s ease-in-out infinite alternate}
@keyframes twinkle{from{opacity:.15;transform:scale(.7)}to{opacity:1;transform:scale(1.1)}}
.sun-disc{position:absolute;left:66%;top:12%;width:170px;height:170px;border-radius:50%;
  background:radial-gradient(circle,#fff7d6 0%,#ffd75e 34%,rgba(255,196,64,.35) 62%,transparent 72%);
  animation:breathe 6s ease-in-out infinite}
@keyframes breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
.moon{position:absolute;right:14%;top:10%;width:74px;height:74px;border-radius:50%;
  background:radial-gradient(circle at 34% 30%,#fbf7e8,#d9d4c2 68%,#b9b4a2);
  box-shadow:0 0 44px rgba(250,246,230,.4),inset -14px -10px 0 rgba(120,120,110,.25)}
.clouds .cl{position:absolute;background:#fff;border-radius:60px;filter:blur(1px);animation:drift linear infinite}
.clouds .cl::before,.clouds .cl::after{content:'';position:absolute;background:inherit;border-radius:50%}
.clouds .cl::before{width:58%;height:170%;left:12%;bottom:22%}
.clouds .cl::after{width:44%;height:130%;right:12%;bottom:26%}
@keyframes drift{from{transform:translateX(-45vw)}to{transform:translateX(115vw)}}
body[data-theme="over-n"] .clouds .cl,body[data-theme="thunder"] .clouds .cl{background:#3c4a5e}
body[data-theme="rain"] .clouds .cl{background:#8b9aa8}
body[data-theme="part-n"] .clouds .cl{background:#51637f}
.rain{position:absolute;inset:-40px 0 0 0}
.rain .r1,.rain .r2{position:absolute;inset:0;transform:rotate(12deg) scale(1.3);animation:rainmove linear infinite}
.rain .r1{background:repeating-linear-gradient(180deg,transparent 0 13px,rgba(230,242,255,.5) 13px 15px);animation-duration:.55s}
.rain .r2{background:repeating-linear-gradient(180deg,transparent 0 21px,rgba(230,242,255,.28) 21px 24px);animation-duration:.85s}
@keyframes rainmove{from{background-position:0 -160px}to{background-position:0 160px}}
.flakes span{position:absolute;top:-14px;background:#fff;border-radius:50%;animation:fall linear infinite}
@keyframes fall{to{transform:translateY(560px)}}
.fogb i{position:absolute;left:-30%;width:160%;height:70px;border-radius:50%;
  background:rgba(240,243,244,.5);filter:blur(24px);animation:fogdrift ease-in-out infinite alternate}
@keyframes fogdrift{from{transform:translateX(-6%)}to{transform:translateX(6%)}}
.flash{position:absolute;inset:0;background:#fff;opacity:0!important;animation:flash 6s infinite}
body[data-theme="thunder"] .flash{opacity:1!important;animation:flash 6s infinite}
@keyframes flash{0%,84%,90%,100%{opacity:0}85%{opacity:.55}86%{opacity:.08}88%{opacity:.4}}

.sky-inner{position:relative;z-index:2;padding:24px 26px 22px;min-height:430px;display:flex;flex-direction:column;gap:14px}
.sky-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:8px;border:2px solid currentColor;border-radius:999px;
  padding:6px 14px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.asof{font-size:11px;letter-spacing:.12em;opacity:.85;text-align:right}
.sky-main{display:flex;align-items:center;gap:26px;flex-wrap:wrap;margin-top:6px}
.bigtemp{display:flex;align-items:flex-start;line-height:.85}
#tval{font-family:'Bricolage Grotesque';font-weight:800;font-size:clamp(84px,13vw,164px);letter-spacing:-.03em;
  text-shadow:0 3px 0 rgba(15,32,56,.12)}
.unit{font-family:'Bricolage Grotesque';font-weight:800;font-size:clamp(24px,3vw,40px);margin-top:clamp(10px,1.6vw,20px)}
.hero-ic{flex:none;filter:drop-shadow(0 4px 0 rgba(15,32,56,.15))}
.sky-sub{font-size:13px;letter-spacing:.06em;font-weight:500;opacity:.95}
.sky-sub b{font-weight:700}
.sky-place{margin-top:auto;padding-top:14px;border-top:2px solid currentColor}
#skyname{font-family:'Bricolage Grotesque';font-weight:800;font-size:clamp(22px,3.6vw,40px);letter-spacing:-.01em;line-height:1}
.sky-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.chip{font-size:10px;font-weight:600;letter-spacing:.12em;border:1.5px solid currentColor;border-radius:6px;padding:4px 8px;opacity:.9}

/* sun arc */
.arc{position:absolute;right:20px;top:70px;z-index:3;width:225px;
  background:rgba(247,244,236,.94);border:2px solid var(--ink);border-radius:11px;box-shadow:var(--shadow-sm);
  padding:10px 12px 8px;color:var(--ink)}
.arc h4{font-size:9px;letter-spacing:.28em;font-weight:700;margin-bottom:2px}
.arc svg{width:100%;display:block}
.arc .times{display:flex;justify-content:space-between;font-size:10px;font-weight:600;margin-top:2px}
.arc .times b{color:var(--accent)}
@media(max-width:640px){.arc{position:static;width:100%;margin-top:6px}}
#sunmk{filter:drop-shadow(0 0 6px rgba(255,181,36,.9))}
#sunmk.night{filter:drop-shadow(0 0 6px rgba(220,230,255,.9))}

/* ---------- metrics ---------- */
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:14px}
.tile{background:var(--card);border:2px solid var(--ink);border-radius:11px;box-shadow:var(--shadow-sm);
  padding:14px 14px 12px;position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s}
.tile::before{content:'';position:absolute;left:0;top:0;bottom:0;width:0;background:var(--accent);transition:width .25s}
.tile:hover{transform:translate(-2px,-3px);box-shadow:6px 7px 0 rgba(15,32,56,.85)}
.tile:hover::before{width:5px}
.tile .lbl{margin-bottom:8px}
.tile .val{font-family:'Bricolage Grotesque';font-weight:800;font-size:27px;line-height:1;display:flex;align-items:center;gap:9px}
.tile .val small{font-family:'IBM Plex Mono';font-size:11px;font-weight:600;opacity:.65}
.tile .sub{font-size:10px;margin-top:8px;opacity:.6;letter-spacing:.05em}
.tile .val svg{flex:none}
#warrow{transition:transform .9s cubic-bezier(.3,1.4,.4,1);transform-origin:12px 12px}

/* ---------- hourly ---------- */
.hrwrap{position:relative}
#chips{display:flex;gap:8px;overflow-x:auto;padding:6px 2px 14px;cursor:grab;position:relative;z-index:2;scrollbar-width:thin}
#chips:active{cursor:grabbing}
#chips::-webkit-scrollbar{height:8px}
#chips::-webkit-scrollbar-thumb{background:var(--ink);border-radius:4px}
#chips::-webkit-scrollbar-track{background:rgba(15,32,56,.12);border-radius:4px}
.hchip{flex:0 0 auto;min-width:62px;text-align:center;background:var(--card);border:2px solid rgba(15,32,56,.35);
  border-radius:10px;padding:9px 6px 8px;transition:transform .18s,border-color .18s,box-shadow .18s}
.hchip:hover{transform:translateY(-4px);border-color:var(--ink);box-shadow:0 4px 0 rgba(15,32,56,.7)}
.hchip.now{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.hchip .hh{font-size:10px;font-weight:700;letter-spacing:.1em;opacity:.75}
.hchip .ht{font-family:'Bricolage Grotesque';font-weight:800;font-size:17px;margin-top:5px}
.hchip .hp{font-size:9px;font-weight:700;color:var(--blue);margin-top:3px;min-height:11px}
.hchip.now .hp{color:#8ec9f5}
#spark{display:block;width:100%;height:74px;margin-top:-6px}
#tip{position:absolute;z-index:5;pointer-events:none;background:var(--ink);color:var(--paper);
  font-size:11px;font-weight:600;padding:6px 9px;border-radius:7px;white-space:nowrap;
  transform:translate(-50%,-115%);opacity:0;transition:opacity .15s}
#tip.on{opacity:1}

/* ---------- daily ---------- */
.drow{display:grid;grid-template-columns:86px 36px 52px 1fr 118px;gap:12px;align-items:center;
  padding:10px 6px;border-bottom:1px dashed rgba(15,32,56,.25);transition:background .15s,transform .15s}
.drow:last-child{border-bottom:0}
.drow:hover{background:var(--paper2);transform:translateX(3px)}
.drow .dn{font-size:12px;font-weight:700;letter-spacing:.08em}
.drow .dp{font-size:10px;font-weight:700;color:var(--blue)}
.dbar{position:relative;height:9px;background:rgba(15,32,56,.14);border-radius:5px;overflow:hidden}
.dbar i{position:absolute;top:0;bottom:0;border-radius:5px;background:linear-gradient(90deg,#35a3ff,#ffb524 60%,#ff5a1f)}
.drow .dt{font-size:12px;font-weight:600;text-align:right;white-space:nowrap}
.drow .dt b{font-weight:700}
@media(max-width:560px){.drow{grid-template-columns:64px 30px 40px 1fr 92px;gap:8px}}

/* ---------- footer / toasts ---------- */
footer{max-width:1280px;margin:0 auto;padding:0 20px 40px;font-size:10px;letter-spacing:.08em;opacity:.85;color:#f2efe6;
  text-shadow:0 1px 2px rgba(10,20,40,.4);line-height:1.8}
footer b{color:#fff}
#toasts{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:99;display:flex;flex-direction:column;gap:8px;align-items:center}
.toast{background:var(--ink);color:var(--paper);border:2px solid var(--paper);border-radius:9px;
  padding:10px 16px;font-size:12px;font-weight:600;box-shadow:var(--shadow-sm);
  animation:tin .3s ease;max-width:88vw;text-align:center}
@keyframes tin{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

/* ---------- loading ---------- */
.skel{position:relative;overflow:hidden;background:rgba(15,32,56,.08)!important;border-radius:6px;color:transparent!important}
.skel *{visibility:hidden}
.skel::after{content:'';position:absolute;inset:0;
  background:linear-gradient(100deg,transparent 20%,rgba(255,255,255,.65) 50%,transparent 80%);
  animation:shimmer 1.1s infinite}
@keyframes shimmer{from{transform:translateX(-100%)}to{transform:translateX(100%)}}

/* ---------- icon animations ---------- */
.ic{overflow:visible;display:block}
.ic .rays{transform-origin:19px 12px;animation:icSpin 26s linear infinite}
@keyframes icSpin{to{transform:rotate(360deg)}}
.ic .drop{animation:icDrop 1.15s linear infinite}
.ic .drop.d2{animation-delay:.35s}.ic .drop.d3{animation-delay:.7s}
@keyframes icDrop{0%{transform:translateY(-1.5px);opacity:0}25%{opacity:1}80%{opacity:1}100%{transform:translateY(4.5px);opacity:0}}
.ic .fl{animation:icFlake 1.9s ease-in infinite}
.ic .fl.f2{animation-delay:.55s}.ic .fl.f3{animation-delay:1.1s}
@keyframes icFlake{0%{transform:translate(0,-2px);opacity:0}30%{opacity:1}100%{transform:translate(-2px,5px);opacity:0}}
.ic .flines line{animation:icFog 2.8s ease-in-out infinite alternate}
.ic .flines line:nth-child(2){animation-delay:.6s}.ic .flines line:nth-child(3){animation-delay:1.2s}
@keyframes icFog{from{transform:translateX(-1.4px)}to{transform:translateX(1.4px)}}
.ic .bolt{animation:icBolt 2.4s infinite}
@keyframes icBolt{0%,40%,100%{opacity:1}44%{opacity:.15}48%{opacity:1}52%{opacity:.3}56%{opacity:1}}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}
@media(max-width:640px){
  .sky-inner{padding:18px}
  header{padding:10px 14px}
  .brand small{display:none}
}
</style>
</head>
<body data-theme="clear-d">

<div class="sky-layer" id="skyA"></div>
<div class="sky-layer" id="skyB"></div>
<div class="vignette"></div>

<header>
  <div class="brand">
    <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
      <circle cx="15" cy="15" r="12" stroke="#f7f4ec" stroke-width="2.4"/>
      <circle cx="15" cy="15" r="3.4" fill="#ff5a1f"/>
      <path d="M15 0v6M15 24v6M0 15h6M24 15h6" stroke="#f7f4ec" stroke-width="2.4"/>
    </svg>
    <div>
      <b>POINT<i>CAST</i></b>
      <small>HI-RES POINT WEATHER · 1.5 KM GRID</small>
    </div>
  </div>
  <div class="hdr-right">
    <div class="seg" role="group" aria-label="Units">
      <button id="uC" class="on">°C</button><button id="uF">°F</button>
    </div>
    <button class="btn ghost slim" id="copylink" title="Copy shareable link">⎘ COPY LINK</button>
    <span id="utc">--:--:-- UTC</span>
    <span class="status"><span class="led" id="led"></span><span id="stat">BOOT</span></span>
  </div>
</header>

<main>
  <!-- LEFT : targeting -->
  <div class="col">
    <section class="panel reveal">
      <div class="ph"><span>TARGET COORDINATES</span><span class="idx">01</span></div>
      <div class="pbody">
        <div class="coords">
